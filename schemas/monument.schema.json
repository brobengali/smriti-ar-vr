{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smriti-ar.org/schemas/monument.schema.json",
  "title": "Monument Metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "location",
    "era",
    "built_by",
    "status",
    "description",
    "timeline",
    "reconstruction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique slug identifier matching the folder name"
    },
    "name": {
      "type": "object",
      "required": ["en", "kn"],
      "properties": {
        "en": { "type": "string" },
        "hi": { "type": "string" },
        "ta": { "type": "string" },
        "bn": { "type": "string" },
        "kn": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Multi-script localized monument names"
    },
    "location": {
      "type": "object",
      "required": ["lat", "lng", "site", "state"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "site": { "type": "string" },
        "state": { "type": "string" }
      },
      "additionalProperties": false
    },
    "era": {
      "type": "string",
      "description": "Historical dynasty and architectural era (e.g. 'Vijayanagara Empire, 14th-16th Century CE')"
    },
    "built_by": {
      "type": "string",
      "description": "Patron monarch, dynasty, or guild"
    },
    "status": {
      "type": "string",
      "enum": ["intact", "ruined", "destroyed"],
      "description": "Physical preservation state"
    },
    "description": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "hi": { "type": "string" },
        "ta": { "type": "string" },
        "bn": { "type": "string" },
        "kn": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Multi-language curated descriptions"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "event"],
        "properties": {
          "year": { "type": ["integer", "string"] },
          "event": { "type": "string" },
          "kind": { "type": "string", "enum": ["build", "destroy", "restore", "milestone"] }
        },
        "additionalProperties": false
      }
    },
    "reconstruction": {
      "$ref": "reconstruction.schema.json"
    },
    "scholar_review_status": {
      "type": "string",
      "enum": ["needs_review", "verified", "peer_reviewed"],
      "default": "needs_review"
    }
  },
  "additionalProperties": false
}
