{
  "name": "bharat-virasat-xr",
  "private": true,
  "version": "0.1.0",
  "description": "Bharat Virasat XR - AR/VR explorer for India's living and lost monuments. Point, identify, learn, and see how destroyed monuments looked in the past.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "validate-data": "tsx scripts/validate-data.ts",
    "preview": "vite preview --host",
    "start": "cross-env NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.27.0",
    "@iwer/sem": "^0.2.5",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/xr": "^6.6.26",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fastify": "^5.12.5",
    "iwer": "^2.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
