# Copy this file to .env and fill in your own values. NEVER commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma / Gemini model used for AI Guide and monument identification
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_TEXT_MODEL=gemma-4-26b-a4b-it

# Image generation model used for "AI vision of the past" (optional feature)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Port for the API proxy server
PORT=8787
